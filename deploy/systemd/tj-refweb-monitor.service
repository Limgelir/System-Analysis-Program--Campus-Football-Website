[Unit]
Description=Check TJ RefWeb HTTPS, database, disk, backups and certificate expiry
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/tj-refweb
EnvironmentFile=/etc/tj-refweb/backend.env
EnvironmentFile=/etc/tj-refweb/ops.env
ExecStart=/usr/bin/node /opt/tj-refweb/deploy/monitor.js
TimeoutStartSec=90s
UMask=0077
StandardOutput=append:/var/log/tj-refweb/monitor.log
StandardError=append:/var/log/tj-refweb/error.log
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tj-refweb/ops
