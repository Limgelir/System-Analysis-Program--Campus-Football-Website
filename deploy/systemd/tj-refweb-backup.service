[Unit]
Description=Consistent TJ RefWeb backup with bounded service downtime
After=mysql.service
OnFailure=tj-refweb-monitor.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/tj-refweb
EnvironmentFile=/etc/tj-refweb/backend.env
EnvironmentFile=/etc/tj-refweb/ops.env
RuntimeDirectory=tj-refweb-backup
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/flock -n /run/lock/tj-refweb-maintenance.lock /usr/bin/node /opt/tj-refweb/deploy/runBackup.js
ExecStopPost=/bin/bash /opt/tj-refweb/deploy/backup-recover.sh
TimeoutStartSec=6h
UMask=0077
Nice=10
StandardOutput=append:/var/log/tj-refweb/backup.log
StandardError=append:/var/log/tj-refweb/error.log

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
