# 复制到服务器 /etc/tj-refweb/backend.env，并设置权限为 600。
# 这是模板，不要在仓库内填写真实密码或密钥。
NODE_ENV=production
TZ=Asia/Shanghai
HOST=127.0.0.1
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=refweb_app
DB_PASSWORD=replace_with_a_unique_database_password
DB_NAME=tj_refweb

JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=12h

# Nginx 同源托管前后端时留空；只有分离部署前端时才填写明确来源。
CORS_ORIGIN=
TRUST_PROXY=loopback
JSON_BODY_LIMIT=1mb

API_RATE_LIMIT_WINDOW_MS=900000
# 校园共用出口起始配置，线上压测后调整；账号级登录失败保护仍独立生效。
API_RATE_LIMIT_MAX=12000
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=120
REGISTRATION_RATE_LIMIT_WINDOW_MS=3600000
REGISTRATION_RATE_LIMIT_MAX=1000

UPLOAD_DIR=/var/lib/tj-refweb/uploads
BACKUP_DIR=/var/backups/tj-refweb
MYSQLDUMP_PATH=/usr/bin/mysqldump
MYSQL_PATH=/usr/bin/mysql
# 可选：如 /etc/tj-refweb/appearance-rollout.json。先校验配置再填写；默认关闭新版。
APPEARANCE_ROLLOUT_FILE=
