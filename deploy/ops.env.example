# 安装到 /etc/tj-refweb/ops.env，root:root 0600；不要提交真实密钥。
# 与 backend.env 均采用 Node --env-file 语法，不用 shell source。
BACKUP_RETENTION_DAYS=7
BACKUP_MAX_AGE_HOURS=30
MONITOR_DISK_PERCENT=80
MONITOR_CERT_DAYS=21
MONITOR_STATE_DIR=/var/lib/tj-refweb/ops
MONITOR_ALERT_REPEAT_HOURS=6
# 留空时仅生成本地故障记录；上线前必须配置并验证接收端。
# HTTP POST JSON 通用 webhook，需要接收 {source,status,time,checks}。
ALERT_WEBHOOK_URL=
# 可改为 smtp 通过邮箱发信；webhook 保持原协议。
ALERT_TRANSPORT=webhook
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_FROM=
ALERT_EMAIL_TO=
# 文件仅包含 SMTP 授权码，root:root 0600；不能使用QQ登录密码。
SMTP_PASSWORD_FILE=/etc/tj-refweb/smtp-password
# 可选异机 Restic 仓库（加密）。开通存储前保持 disabled。
OFFSITE_BACKUP=disabled
# 个人 PC 拉取：改为 pc-pull，安装独立受限 SSH key 和 Windows 计划任务。
PC_BACKUP_MAX_AGE_HOURS=48
PC_BACKUP_DOWNLOAD_KIB=200
# 配置完成后改为 restic，仓库必须是另一台机器/私有对象存储。
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/etc/tj-refweb/restic-password
RESTIC_UPLOAD_KIB=200
# 异机备份限速200 KiB/s，避免持续占满小带宽；根据实际数据量和主机条款调整。
# S3 示例另设 AWS_ACCESS_KEY_ID、AWS_SECRET_ACCESS_KEY；凭据只在本文件中。
