HOST=127.0.0.1
PORT=3000
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=replace_with_local_database_password
DB_NAME=campus_football_course
# API 集成测试只会创建/删除以 _test 结尾的独立数据库；不得填写开发库或生产库名。
TEST_DB_NAME=campus_football_course_test
DB_PORT=3306
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
# 本地开发填写 Vite 地址；生产环境由 Nginx 同源托管前后端时留空。
CORS_ORIGIN=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
TRUST_PROXY=false
JSON_BODY_LIMIT=1mb
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=600
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
REGISTRATION_RATE_LIMIT_WINDOW_MS=3600000
REGISTRATION_RATE_LIMIT_MAX=5
UPLOAD_DIR=./uploads
BACKUP_DIR=./backups
MYSQLDUMP_PATH=mysqldump
# 可选：服务端外观体验名单的绝对路径；留空、总开关关闭或名单为空时全部使用旧版。
APPEARANCE_ROLLOUT_FILE=

# 仅在首次创建或安全重置管理员时临时填写，执行 npm run admin:bootstrap 后立即删除。
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
