{
  "name": "referee-system",
  "version": "1.0.0",
  "description": "校园足球裁判执裁管理系统后端",
  "main": "server.js",
  "scripts": {
    "preview:college-reviews": "node scripts/previewCompetitions.js --college-reviews",
    "test:migration:colleges": "node scripts/verifyCollegeMigration.js",
    "colleges:plan": "node scripts/planCollegeMigration.js",
    "preview:colleges": "node scripts/previewCompetitions.js --colleges",
    "preview:referee-grades": "node scripts/previewRefereeGrades.js",
    "test:migration:referee-grades": "node scripts/verifyRefereeGradeMigration.js",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "npm run test:unit && npm run test:integration",
    "preview:competitions": "node scripts/previewCompetitions.js",
    "preview:competition-options": "node scripts/previewCompetitions.js --visibility",
    "preview:imports": "node scripts/previewCompetitions.js --imports",
    "preview:roster-backfill": "node scripts/previewCompetitions.js --backfill",
    "test:imports": "node scripts/runApiIntegrationTests.js --imports",
    "test:competitions": "node scripts/runApiIntegrationTests.js --competitions",
    "test:migration:imports": "node scripts/verifyImportMigration.js",
    "test:migration:competitions": "node scripts/verifyCompetitionMigration.js",
    "test:unit": "node --test tests/*.test.js",
    "test:integration": "node scripts/runApiIntegrationTests.js",
    "test:ops": "node scripts/runOpsTests.js",
    "test:e2e": "node scripts/runE2ETests.js",
    "audit": "node scripts/audit.js",
    "admin:bootstrap": "node scripts/bootstrapAdmin.js",
    "backup": "node scripts/backup.js",
    "backup:verify": "node scripts/backupMaintenance.js verify",
    "backup:restore": "node scripts/restoreBackup.js",
    "db:init-empty": "node scripts/initDatabase.js",
    "seed:demo": "node scripts/demoSeed.js seed",
    "seed:demo:clear": "node scripts/demoSeed.js clear",
    "seed:demo:plan": "node scripts/demoAppend.js plan",
    "seed:demo:append": "node scripts/demoAppend.js append",
    "migrate": "node scripts/migrate.js up",
    "migrate:status": "node scripts/migrate.js status",
    "migrate:check": "node scripts/migrate.js check",
    "seed:players:plan": "node scripts/playerDemo.js plan",
    "seed:players:append": "node scripts/playerDemo.js append",
    "check:release": "node scripts/checkDualSite.js",
    "preview:supervision": "node scripts/previewCompetitions.js --supervision",
    "test:supervision": "node scripts/runApiIntegrationTests.js --supervision",
    "test:migration:supervision": "node scripts/verifySupervisionMigration.js",
    "test:schedule-deletion": "node scripts/runApiIntegrationTests.js --schedule-deletion",
    "preview:schedule-deletion": "node scripts/previewCompetitions.js --schedule-deletion",
    "test:team-auto-review": "node scripts/runApiIntegrationTests.js --team-auto-review",
    "preview:team-auto-review": "node scripts/previewCompetitions.js --team-auto-review",
    "test:migration:team-auto-review": "node scripts/verifyTeamAutoReviewMigration.js",
    "preview:assignment-board": "node scripts/previewCompetitions.js --assignment-board"
  },
  "keywords": [
    "referee",
    "football",
    "management"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^2.4.0",
    "mysql2": "^3.24.3",
    "nodemailer": "10.0.10",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
